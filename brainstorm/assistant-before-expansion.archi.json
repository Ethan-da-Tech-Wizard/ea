{
  "format": "archi-brainstorm",
  "version": 1,
  "title": "EA: Analysis and Capabilities",
  "decisions": {
    "phase": "Analysis only. Flowcharts and pseudocode; no EA assistant implementation.",
    "presence": "Always visible; helps when asked; movable, resizable, reflowing panel.",
    "platforms": "GNU/Linux first. Keep platform adapters separate for later macOS and Windows.",
    "inference": "Self-hosted and local. Design for a machine with 4 GB total RAM.",
    "actions": "Read files and UI; reveal known menus/submenus. Never activate application commands or run shell commands.",
    "knowledge": "Remember permitted software usage and knowledge. Collection toggle; inspect, edit, delete, and export.",
    "training": "Future opt-in dataset preparation. Compression, memory retrieval, and model training are separate.",
    "collection_off_semantics": "Proposal pending: explicit one-time reads may use ephemeral task memory; a separate Pause blocks all capture."
  },
